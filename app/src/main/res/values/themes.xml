<resources>
    <style name="Theme.OpMedDig" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="buttonStyle">@style/OMD.Button</item>
        <item name="android:buttonStyle">@style/OMD.Button</item>
    </style>

    <style name="Theme.OpMedDig.Ring" parent="Theme.OpMedDig">
        <item name="android:windowBackground">@color/alarm</item>
        <item name="android:statusBarColor">@color/alarm</item>
        <item name="android:navigationBarColor">@color/alarm</item>
    </style>

    <style name="OMD.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="OMD.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="OMD.Label" parent="android:Widget.TextView">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
